#[derive(Debug, Clone)]
pub struct ResponseContent<'response_content, T> {
    pub status: reqwless::response::StatusCode,
    pub content: &'response_content str,
    pub entity: Option<T>,
}

#[derive(Debug)]
pub enum Error<'error, T> {
    Reqwless(reqwless::Error),
    {{#supportMiddleware}}
    ReqwlessMiddleware(reqwless_middleware::Error),
    {{/supportMiddleware}}
    Serde(serde_json::Error),
    {{#useSerdePathToError}}
    SerdePathToError(serde_path_to_error::Error<serde_json::Error>),
    {{/useSerdePathToError}}
    {{^useNoStd}}
    Io(std::io::Error),
    {{/useNoStd}}
    {{#useNoStd}}
    Io(&'error dyn error::Error),
    {{/useNoStd}}
    ResponseError(ResponseContent<'error, T>),
    {{#withAWSV4Signature}}
    AWSV4SignatureError(aws_sigv4::http_request::Error),
    {{/withAWSV4Signature}}
    {{#supportAsync}}
    {{#supportTokenSource}}
    {{#useNoStd}}
    TokenSource(Box<dyn core::error::Error + Send + Sync>),
    {{/useNoStd}}
    {{^useNoStd}}
    TokenSource(Box<dyn std::error::Error + Send + Sync>),
    {{/useNoStd}}
    {{/supportTokenSource}}
    {{/supportAsync}}
    {{#useNoStd}}
    CapacityError(heapless::CapacityError),
    Configuration(String<100>),
    Fmt(core::fmt::Error),
    {{/useNoStd}}
}

{{^useNoStd}}
impl <T> fmt::Display for Error<'_, T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        let (module, e) = match self {
            Error::Reqwless(e) => ("reqwless", format!("{:?}", e)),
            {{#supportMiddleware}}
            Error::ReqwlessMiddleware(e) => ("reqwless-middleware", e.to_string()),
            {{/supportMiddleware}}
            Error::Serde(e) => ("serde", e.to_string()),
            {{#useSerdePathToError}}
            Error::SerdePathToError(e) => ("serde", format!("{}: {}", e.path().to_string(), e.inner().to_string())),
            {{/useSerdePathToError}}
            Error::Io(e) => ("IO", e.to_string()),
            Error::ResponseError(e) => ("response", format!("status code {:?}", e.status)),
            {{#withAWSV4Signature}}
            Error::AWSV4SignatureError(e) => ("aws v4 signature", e.to_string()),
            {{/withAWSV4Signature}}
            {{#supportAsync}}
            {{#supportTokenSource}}
            Error::TokenSource(e) => ("token source failure", e.to_string()),
            {{/supportTokenSource}}
            {{/supportAsync}}
        };
        write!(f, "error in {}: {:?}", module, e)
    }
}
{{/useNoStd}}

