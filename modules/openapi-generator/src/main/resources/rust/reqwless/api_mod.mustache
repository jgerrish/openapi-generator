/// Internal use only
/// A content type supported by this client.
#[allow(dead_code)]
enum ContentType<'content_type> {
    Json,
    Text,
    Unsupported(&'content_type str),
}

impl<'content_type> From<&'content_type str> for ContentType<'content_type> {
    fn from(content_type: &'content_type str) -> Self {
        if content_type.starts_with("application") && content_type.contains("json") {
            return Self::Json;
        } else if content_type.starts_with("text/plain") {
            return Self::Text;
        } else {
            return Self::Unsupported(content_type);
        }
    }
}

impl From<reqwless::headers::ContentType> for ContentType<'_> {
    fn from(content_type: reqwless::headers::ContentType) -> Self {
	match content_type {
	    reqwless::headers::ContentType::ApplicationJson => ContentType::Json,
	    reqwless::headers::ContentType::TextPlain => ContentType::Text,
	    _ => ContentType::Unsupported("Unsupported type"),
	}
    }
}

// TODO: Fix
