impl From<ContentType<'_>> for reqwless::headers::ContentType {
    fn from(content_type: ContentType) -> Self {
	match content_type {
	    ContentType::Json => reqwless::headers::ContentType::ApplicationJson,
	    ContentType::Text => reqwless::headers::ContentType::TextPlain,
	    _ => reqwless::headers::ContentType::TextPlain,
	}
    }
}

